<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Shop.FindLikeWithAnEscapedWildcardMapper">
  <select id="findLikeWithAnEscapedWildcard" resultType="Product">
    SELECT * FROM Sales.Products AS p WHERE p.ProductName LIKE 'W!_%' ESCAPE '!'
  </select>
</mapper>
