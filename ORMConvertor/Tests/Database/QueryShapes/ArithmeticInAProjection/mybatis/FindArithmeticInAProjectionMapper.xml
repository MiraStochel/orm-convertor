<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Shop.FindArithmeticInAProjectionMapper">
  <select id="findArithmeticInAProjection" resultType="ShopOrderLine">
    SELECT ol.LineNumber AS LineNumber, ol.Quantity * ol.UnitPrice AS Total FROM {{schema}}.ShopOrderLines AS ol
  </select>
</mapper>
