<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Shop.FindScalarParameterMapper">
  <select id="findScalarParameter" resultType="OrderLine">
    SELECT * FROM Sales.OrderLines AS ol WHERE ol.Quantity &gt;= #{minQuantity}
  </select>
</mapper>
