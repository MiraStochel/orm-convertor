<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tests</RootNamespace>
    <!-- Connection string of the test database lives in user secrets, never in the repository (S4). -->
    <UserSecretsId>ormconvertor-tests-1f0a2c64-3f1e-4a0b-9b7d-2c5b0f4d8e11</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Database\TestSchema.sql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Database-dependent tests (decision 016): client plus the configuration sources
         the connection string is read from. -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Target framework packages for the acceptance level of artifact verification
         (decision 016): the frameworks themselves judge the generated mapping and class.
         S1 is not violated - the wrappers stay free of them, only the verification depends
         on them. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="NHibernate" />
    <!-- HTTP-level tests of the REST contract (decision 043): the app is started in
         memory and answered over a real HttpClient, so routing, model binding, status
         codes and JSON serialization take part in the verdict. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <!-- Coverage collector for the XPlat Code Coverage data collector of `dotnet test`;
         it measures and decides nothing - no threshold gates the build. -->
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbstractWrappers\AbstractWrappers.csproj" />
    <ProjectReference Include="..\DapperWrappers\DapperWrappers.csproj" />
    <ProjectReference Include="..\DatabaseCatalog\DatabaseCatalog.csproj" />
    <ProjectReference Include="..\EFCoreWrappers\EFCoreWrappers.csproj" />
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\NHibernateWrappers\NHibernateWrappers.csproj" />
    <ProjectReference Include="..\OrmConvertor\OrmConvertor.csproj" />
    <ProjectReference Include="..\ORMConvertorAPI\ORMConvertorAPI.csproj" />
    <ProjectReference Include="..\SampleData\SampleData.csproj" />
  </ItemGroup>

</Project>
