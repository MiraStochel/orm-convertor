<Project Sdk="Microsoft.NET.Sdk">

  <!-- The import of the SEDE query set (decision 208): a console tool outside ORMConvertor.sln,
       as FibenImport and JavaTests are, run by hand over a checkout of hirupert/sede. It writes
       the T-SQL scripts of database/sede/, the Dapper entities and the query catalog of
       SampleData/Sede/; what it writes is committed, so nothing builds or runs it afterwards.
       It takes the target framework from Directory.Build.props and the versions of its two
       packages from Directory.Packages.props: ScriptDom reads the queries for the tables they
       name and the shape of their statement, SqlClient asks a database with the schema what
       each text returns. It also references the test project: the key of a query's ordering
       is what the tool reads off the intermediate representation, through the helper the
       suite holds the FIBEN catalog with (Tests/Verification), so that the catalog states the
       key the run compares by and the suite holds it equal at every build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SedeImport</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <ProjectReference Include="..\Tests\Tests.csproj" />
  </ItemGroup>

</Project>
