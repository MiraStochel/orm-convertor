<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Model\Model.csproj" />
  </ItemGroup>

  <!-- Excerpts of open-source projects (decision 138): read as text, never compiled. Every file
       of the folder is embedded, the licences with the code, under its path below ThirdParty/. -->
  <ItemGroup>
    <Compile Remove="ThirdParty\**" />
    <EmbeddedResource Include="ThirdParty\**" LogicalName="ThirdParty/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The FIBEN catalog (decision 149): the Dapper entities of its 152 tables and the 237
       queries with their questions, generated by FibenImport from the benchmark's files. The
       entities are input to the tool, not source of this project, so they are embedded as text. -->
  <ItemGroup>
    <Compile Remove="Fiben\**" />
    <EmbeddedResource Include="Fiben\**" LogicalName="Fiben/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The SEDE catalog (decision 208): the Dapper entities of the SEDE tables and the
       human-reviewed queries with their titles, generated by SedeImport from the set's files
       the same way. -->
  <ItemGroup>
    <Compile Remove="Sede\**" />
    <EmbeddedResource Include="Sede\**" LogicalName="Sede/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
