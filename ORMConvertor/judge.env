# The judge's mode of the database server (decision 164), passed to compose as
#
#   docker compose --env-file judge.env up -d mssql_db
#
# and by every later compose command that touches mssql_db while it runs in this mode; a command
# without it recreates the database in the measurement mode of decision 145. The judge compares
# rows and measures no time, so it takes every processor the Docker VM has and parallel plans
# over all of them. Nothing measures in this mode: the FIBEN run reads the server's MAXDOP and
# leaves its measurement out.

# Every processor of the VM: an empty value leaves the database unpinned.
DATABASE_CPUSET=

# Parallel plans over every processor the container has.
DATABASE_MAXDOP=0

# The measurement mode's buffer pool. The largest data set, LdbcSnb at scale factor 1, takes
# 2.2 GB and fits; a VM without swap would stop a server that outgrows its share rather than
# slow it down. Raise it only with the memory of the VM.
DATABASE_MAX_SERVER_MEMORY_MB=4096
