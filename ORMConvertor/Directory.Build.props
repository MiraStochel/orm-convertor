<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Version of the tool, for every assembly of the solution at once (decision 034).
         S2 speaks of "the same version of the tool" and S6 wants it in the run record,
         so this number is what ConversionResult.ToolVersion reports. An inherited
         `Version` environment variable would override it, which is why ecosystem.config.js
         blanks that variable before `dotnet run`. -->
    <Version>2.2.0</Version>
    <!-- Every project keeps a packages.lock.json beside its .csproj (decision 186): the
         direct versions are pinned in Directory.Packages.props, the lock file pins the
         transitive graph they resolve to. A plain `dotnet restore` rewrites the lock
         file when a version moved - commit it with the move. CI and the image restore
         in locked mode (RestoreLockedMode), so a lock file that disagrees with the pins fails there
         instead of being rewritten silently. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
